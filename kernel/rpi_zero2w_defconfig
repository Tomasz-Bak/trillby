#
# Trillby Handheld Scanner — Gentoo Linux Kernel Config (Linux 6.6 LTS)
# Target: Raspberry Pi Zero 2 W (ARM Cortex-A53 / BCM2710A1)
# Kernel Version: Linux 6.6 LTS (rpi-6.6.y)
# Memory Constraint: 512MB RAM
# Peripherals: Waveshare 4.0" DSI LCD, I2C Touch, PN532 RFID, GM67 USB HID Barcode, PiSugar 3 Battery
#

# --- Core Architecture & Machine ---
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_BCM2835_PERIPHERALS=y
CONFIG_ARCH_BRCMSTB=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y

# --- PCI & VirtIO Support (QEMU & Dev Emulation) ---
CONFIG_PCI=y
CONFIG_PCI_DOMAINS=y
CONFIG_PCI_DOMAINS_GENERIC=y
CONFIG_PCI_ECAM=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_INPUT=y


# --- Memory & Optimization ---
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_SLUB=y
CONFIG_SLUB_CPU_PARTIAL=y
CONFIG_MMU=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# --- System Init & OpenRC ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PRINTK=y
CONFIG_BUG=y

CONFIG_ELF_CORE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Serial Console Support (QEMU PL011 & RPi UART) ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y


# --- Storage & MMC (SD Card Boot) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_BCM2708=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# --- Display & Graphics (Waveshare 4.0" DSI Panel) ---
CONFIG_HAS_IOMEM=y
CONFIG_FB=y
CONFIG_FB_CFB_FILLRECT=y
CONFIG_FB_CFB_COPYAREA=y
CONFIG_FB_CFB_IMAGEBLIT=y
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_FB_SYS_FOPS=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_SIMPLE=y
CONFIG_DRM_VC4=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y



# --- Input Subsystem & Touchscreen ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_TOUCHSCREEN_FT6X06=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# --- I2C Bus (PN532 RFID + Touch + PiSugar 3 Battery) ---
CONFIG_I2C=y
CONFIG_I2C_BOARDINFO=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM2835=y

# --- USB OTG & HID (GM67 2D Barcode Reader) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# --- Networking & Wi-Fi (Pi Zero 2 W BCM43436) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETFILTER=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y

# --- Security & Crypto ---
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_RNG=y

# --- Stripped Bloat (Disabled to save RAM) ---
# CONFIG_SOUND is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_I915 is not set
# CONFIG_ACCESSIBILITY is not set
# CONFIG_HYPERVISOR_GUEST is not set
